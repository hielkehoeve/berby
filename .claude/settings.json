{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(BERBY_REPORT=1 npx vitest run *)",
      "Bash(npx oxlint)",
      "Bash(npx oxlint *)",
      "Bash(npx prettier --check *)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(bash scripts/check-secrets.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/check-secrets.sh\" --hook",
            "timeout": 30,
            "statusMessage": "Scanning staged files for secrets"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/post-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting and typechecking"
          }
        ]
      }
    ]
  }
}
