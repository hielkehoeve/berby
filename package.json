{
  "name": "berby",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && oxlint && prettier --check . && vitest run && vite build"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/three": "^0.186.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
